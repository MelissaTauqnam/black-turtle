    {
      "parameters": {
        "promptType": "define",
        "hasOutputParser": true,
        "text": "=Tu qualifies des prospects pour une agence d'automatisation.\n\nEntreprise : {{ $json.entreprise }}\nTaille : {{ $json.taille }} salariés\nBesoin exprimé : {{ $json.besoin }}\n\nDonne un score de 0 à 100 (100 = besoin clair, budget probable, urgence), un résumé d'une phrase et la prochaine action conseillée."
      },
