    {
      "parameters": {
        "jsCode": "// Colle tous les articles reçus en un seul texte pour l'IA\nconst articles = $input.all().map((item, i) =>\n  `${i + 1}. ${item.json.title}\\n${item.json.contentSnippet || ''}\\nLien : ${item.json.link}`\n);\nreturn [{ json: { articles: articles.join('\\n\\n') } }];"
      },
