# Base de données (Postgres local via docker-compose en dev)
DATABASE_URL="postgresql://sales_hub:sales_hub@localhost:5432/sales_hub"

# Nom de l'agence et du produit SaaS vendu, utilisés dans les libellés de l'app et le seed
NEXT_PUBLIC_NOM_AGENCE="Atlas Growth"
NEXT_PUBLIC_NOM_PRODUIT_SAAS="Flowdesk"

# --- Réservé aux phases suivantes (non utilisé dans ce V1 "design only") ---
# Supabase (auth + storage + Realtime), à brancher quand on remplacera l'auth simulée
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# n8n (orchestration IA), à brancher quand les webhooks réels seront disponibles
# N8N_BASE_URL=""
# INGEST_API_KEY=""
# INGEST_HMAC_SECRET=""
# USE_N8N_MOCK="true"
